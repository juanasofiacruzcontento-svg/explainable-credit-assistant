# Copia questo file in .env e scegli il provider dell'LLM.
# Con "template" il progetto funziona offline, senza chiavi.
LLM_PROVIDER=template

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# LLM_MODEL=claude-haiku-5-5

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (modello locale gratuito: https://ollama.com) ---
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=llama3.1
